# Canonical production origin, no trailing slash. Used for canonical URLs, sitemap, OG tags.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback if this is unset.
NEXT_PUBLIC_SITE_URL=https://www.moneymetric.io

# Google Analytics 4 measurement ID. Analytics is not loaded at all when unset.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GSC_VERIFICATION=
